<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent><groupId>io.github.adminconsole</groupId><artifactId>admin-console-parent</artifactId><version>0.1.0-SNAPSHOT</version></parent>
  <artifactId>admin-console-demo</artifactId>
  <properties><maven.deploy.skip>true</maven.deploy.skip></properties>
  <dependencies>
    <dependency><groupId>io.github.adminconsole</groupId><artifactId>admin-console-spring-boot-starter</artifactId><version>${project.version}</version></dependency>
    <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter</artifactId></dependency>
    <dependency><groupId>com.microsoft.playwright</groupId><artifactId>playwright</artifactId><version>${playwright.version}</version><scope>test</scope></dependency>
    <dependency><groupId>org.junit.jupiter</groupId><artifactId>junit-jupiter</artifactId><scope>test</scope></dependency>
  </dependencies>
  <build><plugins>
    <plugin><groupId>org.springframework.boot</groupId><artifactId>spring-boot-maven-plugin</artifactId><version>${spring-boot.version}</version><executions><execution><goals><goal>repackage</goal></goals></execution></executions></plugin>
  </plugins></build>
  <profiles>
    <profile><id>e2e</id><build><plugins>
      <plugin><groupId>org.springframework.boot</groupId><artifactId>spring-boot-maven-plugin</artifactId><version>${spring-boot.version}</version><executions>
        <execution><id>start-demo</id><goals><goal>start</goal></goals><configuration><arguments><argument>--server.port=18080</argument></arguments></configuration></execution>
        <execution><id>stop-demo</id><goals><goal>stop</goal></goals></execution>
      </executions></plugin>
      <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-failsafe-plugin</artifactId><version>3.5.4</version><executions><execution><goals><goal>integration-test</goal><goal>verify</goal></goals></execution></executions></plugin>
    </plugins></build></profile>
  </profiles>
</project>
